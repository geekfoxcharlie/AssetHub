{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "assethub:article",
  "title": "Article",
  "description": "Long-form writing or a reprint: an essay, paper, or published piece.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "content": { "type": "string" },
    "author": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "published_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "published", "archived"] },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "examples": [
    {
      "title": "Indexing local files",
      "author": "Ada Lovelace",
      "url": "https://example.com/articles/indexing-local-files",
      "published_at": "2024-03-12T09:00:00Z",
      "status": "published",
      "content": "Keep the record on disk. Treat the database as a catalog, not the source of truth.",
      "tags": ["local-first", "sqlite"]
    }
  ],
  "x-assethub": { "view": "article" }
}
